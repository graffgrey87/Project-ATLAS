# =============================================================================
# ATLAS — Шаблон переменных окружения
# Скопировать в .env и заполнить. НИКОГДА не коммитить .env в репозиторий!
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram (мобильный клиент)
# -----------------------------------------------------------------------------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# СТРОГО числовой user ID (не @username!). Узнать: написать @userinfobot в Telegram.
# Пример: 123456789
ALLOWED_TELEGRAM_ID=

# Порт HTTP-сервера для раздачи APK > 50 МБ
ARTIFACT_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Unity Editor (headless activation)
# -----------------------------------------------------------------------------

# Вариант A — Personal / бесплатная лицензия:
# Содержимое .ulf файла (генерируется через Unity Hub → Manual Activation
# на машине с GUI). Вставить всё содержимое XML одной строкой.
UNITY_LICENSE=

# Вариант B — Plus / Pro лицензия:
UNITY_SERIAL=
UNITY_EMAIL=
UNITY_PASSWORD=

# -----------------------------------------------------------------------------
# GitHub (для MCP и автокоммитов из mobile_bridge)
# -----------------------------------------------------------------------------

# Personal Access Token с правами: repo, read:packages, write:packages
GITHUB_TOKEN=

# Репозиторий проекта (owner/repo), используется в CI/CD и MCP
GITHUB_REPOSITORY=graffgrey87/Project-ATLAS

# -----------------------------------------------------------------------------
# Hugging Face (опционально — только для gated-моделей)
# -----------------------------------------------------------------------------

# Токен HF с правом read (нужен для некоторых моделей с соглашением)
HF_TOKEN=

# -----------------------------------------------------------------------------
# Telegram-уведомления об ошибках (заполняется автоматически из выше)
# Не менять — используется в entrypoint.sh
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN и ALLOWED_TELEGRAM_ID уже заданы выше
